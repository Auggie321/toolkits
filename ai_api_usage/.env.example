# Copy this file to .env and fill in real values.
# The real .env file is ignored by git.

# Gemini / Google Cloud Billing BigQuery Export
#
# Important:
# - GEMINI_API_KEY can call Gemini models, but it cannot query account-level billing usage.
# - This tool reads Gemini usage/cost from Google Cloud Billing export in BigQuery.
# - GEMINI_BQ_PROJECT is the Google Cloud project that stores the billing export dataset.
#   It may be the same as your Gemini project, but it does not have to be.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_BQ_PROJECT=your-gcp-project-id
GEMINI_BQ_DATASET=your_billing_export_dataset
GEMINI_BILLING_TABLE=your-gcp-project-id.your_billing_export_dataset.gcp_billing_export_v1_YOUR_BILLING_ACCOUNT_ID
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-service-account.json
## TOTAL_BUDGET：Enter your Gemini API prepaid amount，e.g. 10.0 for $10. 
## This is used to calculate the percentage of budget used based on the billing export. 
## It does not affect your actual billing or API key usage.
TOTAL_BUDGET=10

# DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# GitHub Copilot premium request usage
# Fine-grained PAT permission: user Plan: read
GITHUB_TOKEN=github_pat_your_token
GITHUB_USERNAME=your-github-login
COPILOT_PREMIUM_LIMIT=300

# Copilot source:
# - api: use GitHub official billing API. This may show billable premium requests, not the UI percentage.
# - settings_page: fetch https://github.com/settings/copilot and parse the UI percentage.
# - auto: use settings_page when GITHUB_SESSION_COOKIE is present, otherwise api.
GITHUB_COPILOT_SOURCE=auto

# Optional. Only needed when you want the same percentage shown on GitHub settings/copilot.
# Copy your logged-in GitHub request Cookie header from the browser devtools.
# Do not commit the real value.
GITHUB_SESSION_COOKIE=

# Bark
BARK_BASE_URL=https://your-bark.example.com
BARK_KEY=your-device-key

# Optional
STATE_PATH=./state.jsonl
HTTP_TIMEOUT_SECONDS=30
