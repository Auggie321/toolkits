# 默认：文本文件自动检测，仓库存 LF
* text=auto

# Shell 脚本强制 LF（Linux/macOS/WSL 直接可运行）
*.sh text eol=lf

# Windows 批处理强制 CRLF（Windows 直接可运行）
*.bat text eol=crlf
*.cmd text eol=crlf

# 配置/文档统一 LF
*.conf text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.py   text eol=lf

# 二进制文件不处理行尾
*.png binary
*.jpg binary
*.mp4 binary
*.zip binary
